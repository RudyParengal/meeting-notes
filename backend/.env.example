# Copy this file to .env and fill in your own keys.
# Never commit the real .env to git.

# ---- Cloud LLM API keys ----
# Google Gemini (for meeting summaries) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# DeepSeek (for action items) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: OpenRouter fallback for any OpenAI-compatible model
OPENROUTER_API_KEY=

# ---- Authentication ----
# Shared API key for the Windows recorder → backend. Generate with: openssl rand -hex 24
# Teams of >1 user should use per-user api_keys in users.json instead.
MEETING_NOTES_API_KEY=mn_generate_a_long_random_hex_string_here

# Admin account email — must match an entry in users.json with role=admin
ADMIN_EMAIL=admin@example.com

# ---- Optional integrations ----
# Webhook fired after each processed meeting (POST JSON: session_id, title, type, user_email, dashboard_url, timestamp)
WEBHOOK_URL=

# Copy each saved .md file to this folder too (e.g., an Obsidian vault on a mounted drive)
EXPORT_FOLDER=

# Public dashboard URL included in webhooks and emails
DASHBOARD_URL=https://notes.example.com

# ---- Storage ----
# Where JSON + Markdown files are written (default /var/meeting-notes)
NOTES_DIR=/var/meeting-notes

# ---- Server ----
HOST=0.0.0.0
PORT=8766
