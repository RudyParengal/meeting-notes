# Copy this file to  backend/.env  and fill in the two REQUIRED lines.
# backend/.env is git-ignored. Never commit it, paste it into a chat, or screenshot it.

# ---------------------------------------------------------------- REQUIRED ---

# The master key. The recorder sends it; it is also the admin's dashboard password.
# Generate one:  python -c "import secrets; print('mn_' + secrets.token_hex(24))"
MEETING_NOTES_API_KEY=

# Your AI provider key. Any OpenAI-compatible service works - see LLM_BASE_URL below.
# Running a local model with Ollama? Leave this empty and set LLM_BASE_URL.
LLM_API_KEY=

# ------------------------------------------------------- AI PROVIDER (pick one) ---
# Defaults (OpenAI) if you set nothing:
#   LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
#
# Google Gemini (cheap and fast):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
#
# Ollama, fully local - meeting text never leaves your computer:
#   LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=llama3.1
#
# Groq / DeepSeek / Together / LM Studio / vLLM: use their OpenAI-compatible URL.
#   (Avoid anonymous routers that keep prompts - transcripts are confidential.)
LLM_BASE_URL=
LLM_MODEL=

# Optional: use a different provider or model for one step. Each of these falls
# back to the LLM_* value above when left empty. Steps: SUMMARY, CLASSIFY, ACTION.
# Example - cheap fast model for everything, a stronger one for action items:
#   ACTION_MODEL=gpt-4o
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL=
CLASSIFY_API_KEY=
CLASSIFY_BASE_URL=
CLASSIFY_MODEL=
ACTION_API_KEY=
ACTION_BASE_URL=
ACTION_MODEL=

# ---------------------------------------------------------------- OPTIONAL ---

# Who the master key logs in as on the dashboard.
ADMIN_EMAIL=admin@localhost

# Where notes and the user list are stored. Default: ./data next to the repo.
# DATA_DIR=

# Listen address. 127.0.0.1 = this computer only (safe default).
# 0.0.0.0 = reachable from other machines - only behind HTTPS (docs/INSTALL.md).
HOST=127.0.0.1
PORT=8766

# Public address of your dashboard, included in webhook messages.
PUBLIC_URL=

# POST a small JSON message here when a note finishes (Slack/Discord/Zapier/etc).
WEBHOOK_URL=

# Also copy each finished .md note into this folder (e.g. an Obsidian vault).
EXPORT_FOLDER=

# Largest accepted audio upload (MB) and transcript (characters).
MAX_UPLOAD_MB=200
MAX_TRANSCRIPT_CHARS=1000000

# Sites allowed to call the API from a browser. The bundled dashboard needs none.
CORS_ORIGINS=

# Set to 1 ONLY if a reverse proxy sits in front and sets X-Forwarded-For.
TRUST_PROXY=
