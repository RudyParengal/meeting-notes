# HTTPS in front of Meeting Notes with nginx.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/meeting-notes   # edit the hostname
#   sudo ln -s /etc/nginx/sites-available/meeting-notes /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d notes.example.com        # gets the certificate and edits this file
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then in backend/.env set:   TRUST_PROXY=1   and   PUBLIC_URL=https://notes.example.com
# and keep HOST=127.0.0.1 - only nginx should reach the app.
#
# REMEMBER: "nginx -t" only proves this file parses. It does not prove the app
# answers. Always finish with:  python3 scripts/doctor.py --server https://notes.example.com --e2e
#
# IMPORTANT - do not put HTTP basic auth or a login redirect in front of the
# recorder's requests. The recorder sends its own X-API-Key header and must reach
# the API directly. A redirect to a login page makes uploads *look* successful
# while the server never receives them.

# Slow down password guessing on the dashboard login (the app also throttles).
limit_req_zone $binary_remote_addr zone=mn_login:10m rate=10r/m;

server {
    listen 80;
    server_name notes.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name notes.example.com;

    # certbot fills these in:
    # ssl_certificate     /etc/letsencrypt/live/notes.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;

    client_max_body_size 200m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    location = /login {
        limit_req zone=mn_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8766;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8766;
        include /etc/nginx/proxy_params;      # sets Host, X-Real-IP, X-Forwarded-For, X-Forwarded-Proto
        proxy_read_timeout 300s;              # AI calls can take minutes
        proxy_send_timeout 300s;
    }
}
