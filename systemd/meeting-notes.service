[Unit]
Description=Meeting Notes API (FastAPI + AI pipeline)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/meeting-notes/backend
EnvironmentFile=/opt/meeting-notes/backend/.env
ExecStart=/opt/meeting-notes/backend/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
