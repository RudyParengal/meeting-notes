{
  "manifest_version": 3,
  "name": "Notewell recorder helper",
  "version": "0.1.0",
  "description": "Sends the active page address, console errors, and failed or slow web requests to Notewell while a screen recording runs.",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "tabs",
    "webRequest",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "console-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
